# Database (Supabase Postgres)
DATABASE_URL=postgresql://postgres.XXXXXX:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:PASSWORD@db.XXXXXX.supabase.co:5432/postgres?sslmode=require

# Auth0
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=  # 32-byte hex: openssl rand -hex 32
APP_BASE_URL=http://localhost:3000

# Admin access (comma-separated emails)
ADMIN_EMAILS=admin@example.com

# AI (at least one)
OPENAI_API_KEY=
GEMINI_API_KEY=
